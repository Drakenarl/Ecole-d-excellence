# École Excellence v3.0.0 — Variables d'environnement
# Copier ce fichier : cp .env.example backend/.env
# Ne JAMAIS committer le fichier .env
# ────────────────────────────────────────────────────────────────

# Serveur
PORT=3001
NODE_ENV=development

# MongoDB Atlas
# Format : mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://adminEcole:Sl3n00sdHEGFAawk@ecole-excellence.f5ba31q.mongodb.net/?appName=ecole-excellence

# JWT — Générer une clé longue et aléatoire (min. 64 caractères)
JWT_SECRET=ecole_excellence_secret_key_remplace_moi_avec_une_longue_chaine_aleatoire_dau_moins_64_caracteres
JWT_EXPIRES_IN=8h

# CORS — En production : mettre l'URL exacte de Netlify
# Exemple : https://ecole-excellence.netlify.app
CORS_ORIGIN=*
